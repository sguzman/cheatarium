gametitle=Need for Speed Underground [U] [SLUS-20811]

//
// USAGE:
// 1. Edit the preset namehash with the name hash of the preset you want (you can use any NFS hashing utility such as NFS-Hasher or Binary). You can find the presets in FrontB (either use Binary or a hex editor and look for the chunk: 20 02 03 00)
// 2. Set the desired performance rating (0.0 = minimum/stock, 5.0 = average, 10.0 = max performance). You can use this website to convert float to hex: https://www.h-schmidt.net/FloatConverter/IEEE754.html
// 3. Save the file, reload cheats in PCSX2, enable the cheat in PCSX2 and start the game
// 4. Go to Underground Mode (play through DDay if you have to, but you have to enter the Underground Mode menu for this to take effect)
// 5. Save the game
// 6. Disable the cheat and reboot. The car should now be in your garage.
//

[Force Car Preset For Underground Mode]
author=xan1242
comment=Open the cheat file for precise usage instructions. Enable once, go to Underground Mode, save the game, then disable and reboot the game.

// Preset namehash (EDDIE_SKYLINE)
patch=1,EE,203EDCD8,word,7A282C98

// Perf rating (float, 10.0)
patch=1,EE,203EDCDC,word,41200000




// HOOK CODE -- DO NOT TOUCH THIS
